# The cockpit (dop-app) — Vite's environment variables.
# Copy it to `.env.local` and adjust it. Nothing here is a secret: it all goes
# into the bundle.

# The BFF's origin (dop-api).
VITE_API_BASE_URL=http://localhost:8000

# The Firebase project — it has to be the SAME as the BFF's (FIREBASE_PROJECT).
VITE_FIREBASE_PROJECT_ID=dop-local
# The Identity Toolkit's public key. Against the emulator any value will do.
VITE_FIREBASE_API_KEY=fake-api-key

# ONLY in the local environment: it points the SDK at the Firebase Auth emulator.
# Leave it EMPTY in production — there the token is signed and the BFF verifies
# the signature.
# The address is k3d's Ingress (stable; a port-forward drops).
VITE_FIREBASE_AUTH_EMULATOR_URL=http://auth.localtest.me:8080

# Required by vite.config.ts.
PORT=5173
BASE_PATH=/

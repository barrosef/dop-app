# Cockpit (dop-app) — variáveis de ambiente do Vite.
# Copie para `.env.local` e ajuste. Nada aqui é segredo: tudo vai para o bundle.

# Origem do BFF (dop-api).
VITE_API_BASE_URL=http://localhost:8000

# Projeto do Firebase — precisa ser o MESMO do BFF (FIREBASE_PROJECT).
VITE_FIREBASE_PROJECT_ID=dop-local
# Chave pública do Identity Toolkit. Contra o emulador qualquer valor serve.
VITE_FIREBASE_API_KEY=fake-api-key

# SÓ no ambiente local: aponta o SDK para o emulador do Firebase Auth.
# Deixe VAZIO em produção — lá o token é assinado e o BFF verifica a assinatura.
# O endereço é o do Ingress do k3d (estável; port-forward cai).
VITE_FIREBASE_AUTH_EMULATOR_URL=http://auth.localtest.me:8080

# Exigidas pelo vite.config.ts.
PORT=5173
BASE_PATH=/

# The cockpit (dop-app) — Vite's environment variables.
# Copy it to `.env.local` and adjust it. Nothing here is a secret: it all goes
# into the bundle.

# The BFF's origin (dop-api).
VITE_API_BASE_URL=http://localhost:8000

# The Firebase project — it has to be the SAME as the BFF's (FIREBASE_PROJECT).
VITE_FIREBASE_PROJECT_ID=dop-local
# The Identity Toolkit's public key. Against the emulator any value will do.
VITE_FIREBASE_API_KEY=fake-api-key
# Where the sign-in popup and the e-mail action links live. Left empty it is
# `<project>.firebaseapp.com`, which is right until a custom domain is served.
VITE_FIREBASE_AUTH_DOMAIN=

# ONLY in the local environment: it points the SDK at the Firebase Auth emulator.
# Leave it EMPTY in production — there the token is signed and the BFF verifies
# the signature.
# The address is k3d's Ingress (stable; a port-forward drops).
VITE_FIREBASE_AUTH_EMULATOR_URL=http://auth.localtest.me:8080

# Required by vite.config.ts.
PORT=5173
BASE_PATH=/

# ── Against QA (GCP, project dop-qa) ─────────────────────────────────────────
# The environment Replit talks to. Real Firebase, real BFF, real database: an
# account created here is a row in Postgres. Use these instead of the block
# above; every value is public by design (it ships in the bundle), and what
# protects the project is the authorized-domains list, not the key.
#
# VITE_API_BASE_URL=https://dop-api-7zftn2aydq-uc.a.run.app
#   (becomes https://api.qa.dop-t.com once the domain is mapped — same API)
# VITE_FIREBASE_PROJECT_ID=dop-qa
# VITE_FIREBASE_API_KEY=AIzaSyA2GKYmTtfNC0L_mHsb235kMwlQ8PT79uQ
# VITE_FIREBASE_AUTH_DOMAIN=dop-qa.firebaseapp.com
#   (becomes auth.qa.dop-t.com once the CNAME propagates — do NOT switch early,
#    the popup flow breaks against a domain that does not serve yet)
# VITE_FIREBASE_AUTH_EMULATOR_URL=
#   (EMPTY: QA is the real Firebase; the BFF verifies the signature)
